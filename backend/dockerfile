# Usa una versione di Python recente e leggera
FROM python:3.11-slim

# Imposta la directory di lavoro
WORKDIR /app

# Installa le dipendenze di sistema essenziali
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copiamo i file di gestione delle dipendenze dalla root
# (Nota: usiamo il context della root per vederli)
COPY pyproject.toml uv.lock* ./

# Installa i pacchetti necessari (se non usi uv nel container, installiamo i pacchetti base)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir anthropic openai tiktoken python-dotenv

# Copia il codice del backend dentro il container
COPY backend/ ./backend/
COPY main.py ./

# Comando per avviare l'applicazione
CMD ["python", "main.py"]
